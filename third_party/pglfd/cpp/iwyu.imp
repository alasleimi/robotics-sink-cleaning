[
  # ---- Core (also covers arch/, util/, functors/, products/, plugins/), generated by Claude ----
  { "include": ["@<Eigen/src/Core/.*>",                  "private", "<Eigen/Core>",                  "public"] },
  { "include": ["@<Eigen/src/plugins/.*>",               "private", "<Eigen/Core>",                  "public"] },
  { "include": ["@<Eigen/src/misc/.*>",                  "private", "<Eigen/Core>",                  "public"] },

  # ---- Dense decomposition / solver modules, generated by Claude ----
  { "include": ["@<Eigen/src/Cholesky/.*>",              "private", "<Eigen/Cholesky>",              "public"] },
  { "include": ["@<Eigen/src/Eigenvalues/.*>",           "private", "<Eigen/Eigenvalues>",           "public"] },
  { "include": ["@<Eigen/src/Geometry/.*>",              "private", "<Eigen/Geometry>",              "public"] },
  { "include": ["@<Eigen/src/Householder/.*>",           "private", "<Eigen/Householder>",           "public"] },
  { "include": ["@<Eigen/src/Jacobi/.*>",                "private", "<Eigen/Jacobi>",                "public"] },
  { "include": ["@<Eigen/src/LU/.*>",                    "private", "<Eigen/LU>",                    "public"] },
  { "include": ["@<Eigen/src/QR/.*>",                    "private", "<Eigen/QR>",                    "public"] },
  { "include": ["@<Eigen/src/SVD/.*>",                   "private", "<Eigen/SVD>",                   "public"] },

  # ---- pybind11 includes, generated by Claude ----
  {"include": ["@<pybind11/detail/.*>", "private", "<pybind11/pybind11.h>", "public"]},

  # ---- Headers iwyu just gets wrong ----
  {"include": ["@<bits/std_abs.h>", "private", "<cmath>", "public"]},
  {"include": ["@<pstl/glue_numeric_impl.h>", "private", "<numeric>", "public"]},

  # ---- Symbols iwyu just gets wrong ----
  { symbol: [ "std::transform", "private", "<algorithm>", "public" ] },
  { symbol: [ "std::for_each", "private", "<algorithm>", "public" ] },
  { symbol: [ "std::find_if", "private", "<algorithm>", "public" ] },
]